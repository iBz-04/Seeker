FIRECRAWL_KEY="API_KEY"
OPENAI_KEY="API_KEY"  
#OR if you want deepseek 
FIREWORKS_API_KEY="your_fireworks_key"
CONTEXT_SIZE="8000"

# Search provider: 'firecrawl' (default) or 'tavily'
