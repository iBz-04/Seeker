# Web search defaults to anonymous Parallel MCP when Firecrawl is unconfigured.
# SEARCH_PROVIDER="parallel"  # parallel | firecrawl | none
# FIRECRAWL_KEY="your_firecrawl_key"
# FIRECRAWL_API_KEY="your_firecrawl_key"  # Alias
# FIRECRAWL_BASE_URL="http://localhost:3002"  # Also selects Firecrawl by default
OPENAI_KEY="API_KEY"  
#OR if you want deepseek 
FIREWORKS_API_KEY="your_fireworks_key"
CONTEXT_SIZE="8000"

#These are optional
RESEARCH_CONCURRENCY=5  # Parallel requests
MAX_TOKENS=4096   

# Optional frontend proxy target
SEEKER_BACKEND_URL="http://127.0.0.1:3051/api/research"
